# ============================================================
# 配置模板：复制成 .env 后填写真实值。
# .env 已在 .gitignore 中，不会提交到 Git。
# 本文件只放占位符，禁止写真实主机 IP、真实密码、真实 API Key。
# ============================================================

# ===== 应用 =====
APP_NAME=企业知识库智能 Agent
APP_ENV=dev
# 只影响日志详细度（true=DEBUG/INFO 全打，false=只打 INFO 以上）
DEBUG=true
API_PREFIX=/api

# 启动参数（APP_HOST 改成 0.0.0.0 可供局域网访问）
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

# 跨域白名单，逗号分隔；留空时 dev 放通全部
# 例：CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# ===== MySQL =====
# 改了 app/models/ 里的表结构，**必须**生成迁移：alembic revision --autogenerate -m "..."
# 然后 alembic upgrade head。create_all() 只会建新表、不会改已有表（详见 README 第 8 节）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=enterprise_kb

# 连接池
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 设为 true 会在控制台打印每条 SQL，排查语句问题时临时打开
SQL_ECHO=false

# ===== Redis =====
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ===== Milvus =====
MILVUS_HOST=your_milvus_host
MILVUS_PORT=19530
# collection 名与 MySQL 表 document_chunks 同名（存的是同一种东西：切分块）
MILVUS_COLLECTION=document_chunks
MILVUS_TIMEOUT=10

# ===== JWT =====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this_to_a_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 初始管理员 =====
# 注册接口默认给 employee 角色，系统里需要有第一个 admin 才能创建知识库。
# 首次启动时 init_db() 会按这两项创建管理员；两项留空则跳过（并记 warning）。
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ===== 自助注册（默认关）=====
# 关着时登录页不显示注册入口，账号由管理员在「用户管理」页开通（POST /api/users）。
# 打开它等于给"谁能进这个系统"开一条不需要许可的公开入口，还会被用来占用户名/邮箱。
# 仅在内网试用这类场景才改成 true。
AUTH_ALLOW_REGISTER=false

# ===== 文档上传 =====
# 落盘根目录，每个知识库一个子目录。已在 .gitignore 中，不会提交。
# 磁盘文件名由服务端用 uuid 生成，不使用用户上传的文件名。
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,txt,md,markdown

# ===== 文本切分 =====
# 单位是字符（不是 token）：BGE-M3 走 API，本地不装 tokenizer。
# 中文 1 字符 <= 1 token，按字符切是偏保守的近似。
# 要求 overlap < size，否则切分不会收敛（代码里会直接报错）。
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ===== LLM (DeepSeek) =====
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
# 注意：该模型默认开着思考模式（思考内容也计费，实测同一问题 token 数翻好几倍），
# 代码里已强制关闭，见 app/rag/llm.py
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
# 生成答案的长度上限（只是上限，正常用不满）
LLM_MAX_TOKENS=2048
# 知识库问答要"照资料说"，不是创作，所以温度调低
LLM_TEMPERATURE=0.3

# ===== RAG 问答 =====
# 送进提示词的检索条数
RAG_TOP_K=5
# 拼进提示词的上下文**字符**上限。超出时从分数最低的结果开始丢弃。
RAG_MAX_CONTEXT_CHARS=6000
# 引用列表里每条展示的正文摘要长度
RAG_SNIPPET_CHARS=120

# ===== Rerank 重排 =====
# 开关：重排只是"让排序更准"，关掉就退回纯向量检索（出问题可一键回退）
RAG_RERANK_ENABLED=true
# 初筛候选数：向量先多召回（保召回率），再精排到 RAG_TOP_K 条（保精度）
# 必须 >= RAG_TOP_K，否则精排没有挑选余地（启动时会校验）
RAG_CANDIDATE_K=20
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=30

# ===== 限流 =====
# 保护的是"钱"：一次问答要打 rerank + LLM 两个付费上游。
# 计数落在 Redis（连接参数见上面的 REDIS_*），所以 uvicorn --workers > 1 也准确。
# ⚠️ Redis 不可用时**放行**（降级，避免把问答整个打死）—— 代价是那段时间额度失控，
#    所以 GET /health 会把 redis 单独报出来。
RATE_LIMIT_ENABLED=true
# 每个用户每分钟的配额，配 0 表示该类型不限流
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_VECTORIZE_PER_MINUTE=5

# ===== Agent =====
# 开关：Agent 一次问答要多调 2~4 次大模型，出问题可一键退回 /api/chat（纯 RAG）
AGENT_ENABLED=true
# 最多检索几轮 —— **成本硬闸门**：要不要再检索一次是模型自己决定的，
# 没有上限就等于把花费交给它。2 轮足够覆盖"换个关键词再找一次"。
AGENT_MAX_ITERATIONS=2

# ===== 会话记忆（Phase 9）=====
# 带进提示词的历史轮数（1 轮 = 一问一答 = 2 条消息）。
# 0 = 不带历史，退回到"每次问答互相独立"的单轮行为（可用于对比多轮有没有用）。
# 别调太大：历史按字面拼进提示词，token 随轮数线性上涨，而越旧的轮次相关性越差。
CONVERSATION_MAX_HISTORY_TURNS=5

# ===== 长对话摘要压缩（Phase 12）=====
# 滑出"最近 N 轮"窗口的旧轮次会被增量压成一段滚动摘要，拼进系统提示词。
# **默认关**：一次压缩多调一次模型，先有开关两组数据再谈值不值；关掉时行为与从前逐字一致。
# ⚠️ 开启后 CONVERSATION_MAX_MESSAGES 必须 ≥ (CONVERSATION_MAX_HISTORY_TURNS + TRIGGER_TURNS) × 2，
#    否则摘要永远攒不够输入（一次都不生成）而裁剪照常删旧轮次 —— 启动时会直接报错拦住这种配置。
CONVERSATION_SUMMARY_ENABLED=false
# 攒够多少轮"已滑出窗口且未被摘要"的对话才压缩一次（太小会频繁调模型）
CONVERSATION_SUMMARY_TRIGGER_TURNS=10
# 摘要拼进提示词的字符上限（超出按尾部截断，保留更近的部分）
CONVERSATION_SUMMARY_MAX_CHARS=800

# ===== 数据保留（Phase 10）=====
# 治的是"只增不减"。三项各自独立，**0 = 不限**。
# ⚠️ 后两项是**不可逆**的删除（在写入时机会式执行，没有调度器），每次真删都会打 WARNING。
# 每用户最多保留多少个会话；超了拒绝新建并提示先删旧会话（不静默丢数据）
CONVERSATION_MAX_PER_USER=200
# 每个会话最多保留多少条消息；超了按**整轮**删最旧的（不留下孤立的答案）
CONVERSATION_MAX_MESSAGES=100
# agent_logs 保留天数（纯排障数据）
AGENT_LOG_RETENTION_DAYS=30

# ===== 长期记忆（Phase 11）=====
# 跨会话记住"关于用户的稳定事实"。**默认关**：默认关是为了能对比开关两组的
# token 与答案差异；关掉时提示词与上一阶段逐字一致。
USER_MEMORY_ENABLED=false
# 每用户最多存多少条（0 = 不限）。超了拒绝写入并提示，不静默删旧记忆。
USER_MEMORY_MAX_PER_USER=200
# 送进提示词最多几条（按最近更新倒序；0 = 不带记忆）
USER_MEMORY_MAX_ITEMS=20
# 记忆段的字符预算，超出从最旧的开始丢（防它把检索到的资料挤出上下文）
USER_MEMORY_MAX_CHARS=1000

# ===== Embedding (BGE-M3，走 API) =====
# 注意：与 LLM 分开配置，因为可能是两家服务商
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=your_embedding_base_url
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 每批送多少条去向量化。实测该接口 200 条也能一次收下，
# 且延迟不随条数线性增长，所以批量送比逐条快得多。
EMBEDDING_BATCH_SIZE=64
