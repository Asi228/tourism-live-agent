__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# 环境变量（含密钥，禁止提交）
.env

# 日志
logs/
*.log

# IDE
.idea/
.vscode/

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# 上传文件与向量库本地数据
uploads/

# RPA 执行截图证据（按任务分目录；属运行产物，不进仓库）
artifacts/

# 前端（依赖与构建产物都不进仓库）
frontend/node_modules/
frontend/dist/
frontend/.vite/
# vite 在配置热重载时会生成 vite.config.js.timestamp-*.mjs；
# 进程被强杀时来不及清理，就会留在目录里（实测踩到过两个，被 git 当成新文件）
frontend/*.timestamp-*.mjs


# 工作区内部记录（含内网 IP、密码等），禁止提交
.workbuddy/
